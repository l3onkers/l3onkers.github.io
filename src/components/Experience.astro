---
import ExperienceItem from "./ExperienceItem.astro"
import { type ui } from '../i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;

// Data would normally come from i18n or Content Collections, but keeping it simple for the portfolio.
const EXPERIENCE = [
  {
    date: lang === 'es' ? 'Febrero 2025 - Presente' : 'February 2025 - Present',
    title: 'Senior DevOps Expert & SRE | Gitlab PSE | Solutions Architect',
    company: 'knowmad mood',
    description: lang === 'es' ? 'Gestión avanzada de GitLab, administración on-premises y automatización integral CI/CD. Diseño e implementación de pipelines en entornos híbridos y definición de estándares arquitectónicos DevOps.' : 'Advanced GitLab management, on-premises administration, and comprehensive CI/CD automation. Design and implementation of pipelines in hybrid environments and definition of DevOps architectural standards.',
  },
  {
    date: lang === 'es' ? 'Febrero 2023 - Enero 2025' : 'February 2023 - January 2025',
    title: 'DevOps Team Lead & Solutions Architect',
    company: 'CoverManager',
    description: lang === 'es' ? 'Liderazgo técnico del equipo DevOps. Responsable del análisis, diseño y planificación de arquitecturas Cloud, automatización de infraestructuras y procesos de integración continua.' : 'Technical leadership of the DevOps team. Responsible for the analysis, design, and planning of Cloud architectures, infrastructure automation, and continuous integration processes.',
  },
  {
    date: lang === 'es' ? 'Octubre 2021 - Diciembre 2022' : 'October 2021 - December 2022',
    title: 'DevOps Engineer & Solutions Architect',
    company: 'Wellness TechGroup',
    description: lang === 'es' ? 'Análisis, diseño y despliegue de infraestructuras On Premise y SaaS. Automatización de flujos de datos IoT, administración de BBDD y pipelines CI/CD con AWS y Azure DevOps.' : 'Analysis, design, and deployment of On Premise and SaaS infrastructures. Automation of IoT data flows, database administration, and CI/CD pipelines using AWS and Azure DevOps.',
  },
  {
    date: lang === 'es' ? 'Abril 2019 - Marzo 2021' : 'April 2019 - March 2021',
    title: 'DevOps Specialist & Sysadmin',
    company: 'Agilia Center',
    description: lang === 'es' ? 'Administración integral de entornos AWS (EC2, S3, ECS, Lambda). Desarrollo de herramientas en Bash y Python para la automatización de procesos recurrentes y securización de infraestructuras críticas.' : 'Comprehensive administration of AWS environments (EC2, S3, ECS, Lambda). Tool development in Bash and Python for recurrent process automation and critical infrastructure securitization.',
  }
]
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experiencie, i) => (
      <li class="anim-fade-in" style={`animation-delay: ${i * 150}ms`}>
        <ExperienceItem {...experiencie} />
      </li>
    ))
  }
</ol>
