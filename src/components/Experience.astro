---
import ExperienceItem from "./ExperienceItem.astro"
import { type ui } from '../i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;

// Data would normally come from i18n or Content Collections, but keeping it simple for the portfolio.
const EXPERIENCE = [
  {
    date: lang === 'es' ? 'FEB 2025 - Actualidad' : 'FEB 2025 - Present',
    title: lang === 'es' ? 'Especialista Senior DevOps - SRE & Arquitecto de Soluciones' : 'Senior DevOps - SRE Specialist & Solutions Architect',
    company: 'Knowmadmood',
    description: lang === 'es' ? 'Automatización total del ciclo de vida del software en entornos híbridos utilizando Terraform y GitLab CI/CD. Integración de modelos de IA avanzados (Claude 3, Copilot, HuggingFace) en los flujos de trabajo diarios para el Code Scaffolding. Administración de instancias de GitLab on-premises a gran escala, y configuración de flujos de trabajo de observabilidad (Prometheus, Datadog).' : 'Total automation of the software lifecycle in hybrid environments using Terraform and GitLab CI/CD. Integration of advanced AI models (Claude 3, Copilot, HuggingFace) into daily workflows for Code Scaffolding. Large-scale on-premises GitLab instance administration, and configuration of observability workflows (Prometheus, Datadog).',
  },
  {
    date: lang === 'es' ? 'FEB 2023 - FEB 2025' : 'FEB 2023 - FEB 2025',
    title: lang === 'es' ? 'Líder de Equipo DevOps & Arquitecto de Soluciones' : 'DevOps Team Lead & Solutions Architect',
    company: 'Covermanager',
    description: lang === 'es' ? 'Liderazgo de un equipo DevOps de 2 ingenieros, diseñando una arquitectura AWS altamente escalable. Mitigación exitosa de un ataque DDoS masivo asegurando la continuidad del negocio y reduciendo costes de AWS. Administración de clústeres de PostgreSQL y MongoDB de alta concurrencia, y automatización de soluciones CI/CD Serverless.' : 'Leadership of a 2-engineer DevOps team, designing a highly scalable AWS architecture. Successful mitigation of a massive DDoS attack ensuring business continuity and reducing AWS costs. Administration of high-concurrency PostgreSQL and MongoDB clusters, and automation of Serverless CI/CD solutions.',
  },
  {
    date: lang === 'es' ? 'OCT 2021 - FEB 2023' : 'OCT 2021 - FEB 2023',
    title: lang === 'es' ? 'Especialista DevOps & Arquitecto de Soluciones' : 'DevOps Specialist & Solutions Architect',
    company: 'Wellness TechGroup',
    description: lang === 'es' ? 'Diseño y planificación de soluciones CI/CD utilizando Jenkins y Azure-DevOps. Ejecución de análisis de riesgo e impacto con herramientas de escaneo de seguridad en flujos de datos IoT. Implementación y escalado de infraestructuras On-Premise y SaaS, y gestión del Change Management.' : 'Design and planning of CI/CD solutions using Jenkins and Azure-DevOps. Execution of risk and impact analysis with security scanning tools in IoT data flows. Implementation and scaling of On-Premise and SaaS infrastructures, and Change Management administration.',
  },
  {
    date: lang === 'es' ? 'ABR 2021 - SEP 2021' : 'APR 2021 - SEP 2021',
    title: lang === 'es' ? 'Especialista DevOps & Arquitecto de Soluciones' : 'DevOps Specialist & Solutions Architect',
    company: 'ViewNext / Kyndryl',
    description: lang === 'es' ? 'Gestión de un equipo técnico de 5 ingenieros para el despliegue en producción de aplicaciones críticas aplicando la metodología ITIL. Gestión del ciclo de vida completo del software y administración de la CMDB en Oracle, SQL Server y sistemas legacy.' : 'Management of a 5-engineer technical team for production deployment of critical applications applying ITIL methodology. Full software lifecycle management and CMDB administration on Oracle, SQL Server, and legacy systems.',
  },
  {
    date: lang === 'es' ? 'ABR 2019 - MAR 2021' : 'APR 2019 - MAR 2021',
    title: lang === 'es' ? 'Especialista DevOps & Administrador de Sistemas Linux' : 'DevOps Specialist & Linux Systems Administrator',
    company: 'Agilia Center',
    description: lang === 'es' ? 'Administración de infraestructuras AWS Cloud a gran escala y bases de datos. Resolución y gestión de incidentes críticos garantizando 99.9% de uptime. Mitigación de riesgos mediante el análisis de impacto.' : 'Large-scale AWS Cloud infrastructure and database administration. Resolution and management of critical incidents ensuring 99.9% uptime. Risk mitigation through impact analysis.',
  }
]
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experiencie, i) => (
      <li class="anim-fade-in" style={`animation-delay: ${i * 150}ms`}>
        <ExperienceItem {...experiencie} />
      </li>
    ))
  }
</ol>
