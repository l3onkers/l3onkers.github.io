---
import { useTranslations, type ui } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { title: t('nav.experience'), url: '#experiencia' },
  { title: t('nav.projects'), url: '#proyectos' },
  { title: t('nav.about'), url: '#sobre-mi' },
  { title: t('nav.contact'), url: 'mailto:contacto@alvaro-escobar.dev' },
];

const altLang = lang === 'es' ? 'en' : 'es';
const altUrl = lang === 'es' ? '/en' : '/';
---

<header class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-4">
  <nav class="flex px-4 py-1.5 text-sm font-medium rounded-full text-gray-700 dark:text-gray-200 justify-center items-center bg-gray-100/80 dark:bg-gray-800/80 backdrop-blur-md shadow ring-1 ring-gray-900/10 dark:ring-white/10">
    {
      navItems.map((item) => (
        <a class="relative block px-2 py-1 transition duration-200 hover:text-violet-600 dark:hover:text-violet-400" href={item.url}>
          {item.title}
        </a>
      ))
    }
    <div class="ml-2 pl-2 border-l border-gray-300 dark:border-gray-600 flex items-center gap-2">
      <a href={altUrl} class="px-2 py-1 text-xs font-bold uppercase transition hover:text-violet-600 dark:hover:text-violet-400">
        {altLang}
      </a>
      <ThemeToggle />
    </div>
  </nav>
</header>

