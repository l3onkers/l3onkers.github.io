---
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {}

const { href, class: className, target, rel, ...rest } = Astro.props;
const isMailto = typeof href === 'string' && href.startsWith('mailto:');
const computedTarget = target ?? (isMailto ? '_self' : '_blank');
const computedRel = rel ?? (isMailto ? undefined : 'noopener noreferrer');
---

<a
  href={href}
  target={computedTarget}
  rel={computedRel}
  class={`rounded-full border border-white/10 flex justify-center items-center gap-x-2 py-1 px-2 md:py-2 md:px-4 text-xs md:text-base text-white/90 bg-white/5 hover:scale-110 hover:bg-white/10 transition ${className ?? ''}`}
  {...rest}
>
  <slot />
</a>
