---
import GitHubIcon from '../icons/GitHub.astro';
import CodeIcon from '../icons/Code.astro';
import { type ui } from '../i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;

const TAGS = {
  AWS: {
    name: "AWS",
    class: "bg-[#232F3E] text-white",
  },
  TERRAFORM: {
    name: "Terraform",
    class: "bg-[#844FBA] text-white",
  },
  KUBERNETES: {
    name: "Kubernetes",
    class: "bg-[#326CE5] text-white",
  }
}

const PROJECTS = [
  {
    title: lang === 'es' ? "Migración a Arquitectura Cloud Native" : "Cloud Native Architecture Migration",
    description: lang === 'es' ? "Diseño e implementación de una migración completa de monolito a microservicios usando EKS, Terraform y GitOps con ArgoCD." : "Design and implementation of a complete monolith to microservices migration using EKS, Terraform and GitOps with ArgoCD.",
    link: "#",
    github: "#",
    image: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80&w=1000",
    tags: [TAGS.AWS, TAGS.KUBERNETES, TAGS.TERRAFORM],
  }
]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }, i) => (
      <article class="anim-fade-in flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0" style={`animation-delay: ${i * 150}ms`}>
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-200 dark:lg:border-gray-800 lg:hover:border-gray-300 dark:lg:hover:border-gray-700 lg:hover:bg-gray-100/50 dark:lg:hover:bg-gray-800/50">
            <img alt={title} class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" src={image} />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row mb-2 gap-x-2">
              {tags.map((tag) => (
                <li>
                  <span class={`flex gap-x-2 rounded-full text-xs py-1 px-2 border border-black/10 dark:border-white/10 ${tag.class}`}>
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400">{description}</div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <a href={github} class="bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 text-gray-900 dark:text-white py-2 px-4 border border-gray-300 dark:border-gray-600 rounded-full inline-flex items-center gap-x-2 transition">
                  <GitHubIcon class="size-4" />
                  Code
                </a>
              )}
              {link && (
                <a href={link} class="bg-violet-600 hover:bg-violet-700 text-white py-2 px-4 border border-violet-600 rounded-full inline-flex items-center gap-x-2 transition">
                  <CodeIcon class="size-4" />
                  Preview
                </a>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
