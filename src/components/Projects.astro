---
import GitHubIcon from '../icons/GitHub.astro';
import CodeIcon from '../icons/Code.astro';
import { type ui } from '../i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;

const TAGS = {
  AWS: {
    name: "AWS",
    class: "bg-[#232F3E] text-white",
  },
  TERRAFORM: {
    name: "Terraform",
    class: "bg-[#844FBA] text-white",
  },
  GITLAB: {
    name: "GitLab CI/CD",
    class: "bg-[#FC6D26] text-white",
  },
  AZURE: {
    name: "Azure DevOps",
    class: "bg-[#0078D4] text-white",
  },
  PYTHON: {
    name: "Python / Bash",
    class: "bg-[#3776AB] text-white",
  }
}

const PROJECTS = [
  {
    title: lang === 'es' ? "Enterprise GitOps & Pipelines CI/CD" : "Enterprise GitOps & CI/CD Pipelines",
    description: lang === 'es' ? "Diseño e implementación de pipelines CI/CD en entornos híbridos (On-Premise y Cloud). Automatización integral del ciclo de vida del software, garantizando despliegues consistentes, seguros y trazables." : "Design and implementation of CI/CD pipelines in hybrid environments (On-Premise and Cloud). Comprehensive automation of the software lifecycle, ensuring consistent, secure, and traceable deployments.",
    link: "",
    github: "",
    image: "https://images.unsplash.com/photo-1618401471353-b98afee0b2eb?auto=format&fit=crop&q=80&w=1000",
    tags: [TAGS.GITLAB, TAGS.AWS, TAGS.PYTHON],
  },
  {
    title: lang === 'es' ? "Cloud Infrastructure & SecOps" : "Cloud Infrastructure & SecOps",
    description: lang === 'es' ? "Administración avanzada y securización de arquitecturas en AWS (EC2, ECS, Lambda, S3, CloudFront). Análisis de riesgos y desarrollo de scripts para automatización de procesos recurrentes y remediación." : "Advanced administration and securitization of AWS architectures (EC2, ECS, Lambda, S3, CloudFront). Risk analysis and script development for recurrent process automation and remediation.",
    link: "",
    github: "",
    image: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80&w=1000",
    tags: [TAGS.AWS, TAGS.TERRAFORM, TAGS.PYTHON],
  },
  {
    title: lang === 'es' ? "Microservicios & Flujos de Datos IoT" : "Microservices & IoT Data Flows",
    description: lang === 'es' ? "Gestión y configuración de flujos de datos IoT en arquitecturas de alta concurrencia. Administración de bases de datos SQL/NoSQL y optimización del rendimiento bajo metodologías CI/CD con Azure." : "Management and configuration of IoT data flows in high-concurrency architectures. SQL/NoSQL database administration and performance optimization using CI/CD methodologies with Azure.",
    link: "",
    github: "",
    image: "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&q=80&w=1000",
    tags: [TAGS.AZURE, TAGS.PYTHON],
  }
]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }, i) => (
      <article class="anim-fade-in flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0" style={`animation-delay: ${i * 150}ms`}>
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition-all duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-[0_20px_60px_-10px_rgba(139,92,246,0.2)] lg:border lg:border-gray-200 dark:lg:border-gray-800 lg:hover:border-violet-400/30 dark:lg:hover:bg-gray-800/50">
            <img alt={title} class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" src={image} loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" aria-hidden="true"></div>
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row mb-2 gap-x-2">
              {tags.map((tag) => (
                <li>
                  <span class={`flex gap-x-2 rounded-full text-xs py-1 px-2 border border-black/10 dark:border-white/10 ${tag.class}`}>
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400">{description}</div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <a href={github} aria-label={`Ver código fuente del proyecto ${title}`} class="bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 text-gray-900 dark:text-white py-2 px-4 border border-gray-300 dark:border-gray-600 rounded-full inline-flex items-center gap-x-2 transition">
                  <GitHubIcon class="size-4" />
                  Code
                </a>
              )}
              {link && (
                <a href={link} aria-label={`Ver demostración en vivo del proyecto ${title}`} class="bg-violet-600 hover:bg-violet-700 text-white py-2 px-4 border border-violet-600 rounded-full inline-flex items-center gap-x-2 transition">
                  <CodeIcon class="size-4" />
                  Preview
                </a>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
